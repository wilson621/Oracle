{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./.tmp-guidance-verification",
    "noEmit": false,
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "lib/companion/guidance/**/*.ts",
    "scripts/verify-companion-guidance-contracts.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist-electron"
  ]
}
