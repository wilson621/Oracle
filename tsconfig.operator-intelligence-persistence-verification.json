{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./.tmp-operator-intelligence-persistence-verification",
    "noEmit": false,
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "lib/oracle/understanding/**/*.ts",
    "lib/oracle/repositories/operator-intelligence-repository.ts",
    "lib/oracle/repositories/operator-intelligence-pagination.ts",
    "scripts/operator-understanding-verification-fixtures.ts",
    "scripts/verify-operator-intelligence-persistence.ts",
    "scripts/verify-operator-intelligence-concurrency.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist-electron"
  ]
}
